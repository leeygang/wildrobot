{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["continue"]
    },
    "summary": {
      "type": "string"
    },
    "failure_mode": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "intervention_family": {
      "type": "string",
      "enum": [
        "failure_state_replay",
        "recovery_curriculum",
        "torque_headroom",
        "stance_geometry",
        "reference_tracking",
        "optimizer_diagnostic",
        "infrastructure"
      ]
    },
    "expected_outcome": {
      "type": "string"
    },
    "falsification_condition": {
      "type": "string"
    },
    "config": {
      "type": "string"
    },
    "start_mode": {
      "type": "string",
      "enum": ["init_policy", "resume", "none"]
    },
    "checkpoint": {
      "type": "string"
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "decision",
    "summary",
    "failure_mode",
    "hypothesis",
    "intervention_family",
    "expected_outcome",
    "falsification_condition",
    "config",
    "start_mode",
    "checkpoint",
    "verification"
  ],
  "additionalProperties": false
}
